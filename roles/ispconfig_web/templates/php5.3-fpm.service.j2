# Managed by Ansible (ispconfig_web role): PHP 5.3 built from source.
[Unit]
Description=The PHP 5.3 FastCGI Process Manager
After=network.target

[Service]
Type=simple
PIDFile=/run/php/php5.3-fpm.pid
# The packaged command line (/usr/sbin/php-fpm5.3 sets FPM's php.ini), which ispconfig-php-limits recognises. PHP 5.3
# has no systemd notification, so the service is simple.
ExecStartPre=/usr/sbin/php-fpm5.3 --test --fpm-config {{ ispconfig_php53_config_dir }}/fpm/php-fpm.conf
ExecStart=/usr/sbin/php-fpm5.3 --nodaemonize --fpm-config {{ ispconfig_php53_config_dir }}/fpm/php-fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
RuntimeDirectory=php
RuntimeDirectoryPreserve=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
